#!/usr/bin/env bash
# Pre-push gate — Jekyll build sanity + cross-repo fact-drift guard.
# The local stand-in for CI (this repo has none). Bypass (use sparingly): git push --no-verify
set -uo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'
pass(){ printf "${GREEN}✓${NC} %s\n" "$1"; }
fail(){ printf "${RED}✗${NC} %s\n" "$1"; }
warn(){ printf "${YELLOW}⚠${NC} %s\n" "$1"; }
info(){ printf "${CYAN}→${NC} %s\n" "$1"; }
cmd(){ command -v "$1" &>/dev/null; }

ERRORS=0
printf "\n${BOLD}── Pre-push: Jekyll build + fact-drift gate ──${NC}\n"

if cmd bundle; then
  info "jekyll build (sanity check)"
  SANITY_DIR="$(mktemp -d)"
  if bundle exec jekyll build -d "$SANITY_DIR" >/dev/null 2>&1; then
    pass "Jekyll build OK"
  else
    fail "Jekyll build failed — run: bundle exec jekyll build"
    ERRORS=$((ERRORS+1))
  fi
  rm -rf "$SANITY_DIR"
else
  warn "bundle not found (run: bundle install) — skipping Jekyll build check"
fi

# Cross-stack fact drift — runs only in the full multi-repo workspace (no-op on a lone clone).
GUARD="$PWD/../scripts/check_facts.py"
if [[ -f "$GUARD" ]] && cmd python3; then
  info "fact drift (facts.yml ↔ code ↔ site)"
  if python3 "$GUARD" >/dev/null 2>&1; then pass "Facts consistent"; else fail "Fact drift — run: python3 ../scripts/check_facts.py"; ERRORS=$((ERRORS+1)); fi
else
  warn "scripts/check_facts.py not found (lone clone, not the full workspace) — skipping fact drift check"
fi

printf "\n${BOLD}── Result ──${NC}\n"
if [[ $ERRORS -gt 0 ]]; then
  fail "${ERRORS} check(s) failed — push blocked (bypass: git push --no-verify)"
  exit 1
fi
pass "All pre-push checks passed"
